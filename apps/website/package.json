{
	"name": "website",
	"version": "0.0.2",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "dotenv -e ../../.env -- next dev --port 3001",
		"build": "dotenv -e ../../.env -- contentlayer2 build && pnpm run generate-component-json && pnpm run generate-examples-json && next build",
		"start": "dotenv -e ../../.env -- next start",
		"db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
		"db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
		"format:write": "prettier --log-level silent --write \"**/*.{ts,tsx,mdx}\" --cache",
		"format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
		"lint": "next lint",
		"postbuild": "dotenv -e ../../.env -- next-sitemap --config next-sitemap.config.cjs",
		"generate-component-json": "tsx src/scripts/generate-component-json.ts",
		"generate-examples-json": "tsx src/scripts/generate-examples-json.ts"
	},

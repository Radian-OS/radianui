{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"aliases": {
			"type": "object",
			"properties": {
				"utils": {
					"type": "string"
				},
				"components": {
					"type": "string"
				},
				"ui": {
					"type": "string"
				},
				"lib": {
					"type": "string"
				},
				"hooks": {
					"type": "string"
				},
				"animated": {
					"type": "string"
				}
			},
			"required": ["utils", "components", "ui"]
		},
		"hasSrcDir": { "type": "boolean" }
	},
	"required": ["aliases", "hasSrcDir"]
}

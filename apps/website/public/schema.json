{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "URL to the JSON schema for validation"
		},
		"style": {
			"type": "string",
			"enum": ["default", "sera"],
			"description": "Style of the components"
		},
		"aliases": {
			"type": "object",
			"properties": {
				"utils": {
					"type": "string"
				},
				"components": {
					"type": "string",
					"description": "Alias for the components directory."
				},
				"ui": {
					"type": "string"
				},
				"lib": {
					"type": "string"
				},
				"hooks": {
					"type": "string"
				},
				"animated": {
					"type": "string"
				}
			},
			"required": ["utils", "components", "ui"]
		},
		"hasSrcDir": {
			"type": "boolean",
			"description": "Whether the project uses a src directory."
		}
	},
	"required": ["aliases", "hasSrcDir", "style"]
}

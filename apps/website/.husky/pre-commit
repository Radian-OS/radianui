# Get the current branch name
CURRENT_BRANCH=$(git branch --show-current)

echo "🚀 Running pre-commit checks..."

# Step 1: Run Prettier to format the code (runs for every branch)
echo "🎨 Formatting code with Prettier..."
pnpm run format:write || exit 1

# Step 2: Check if the current branch is 'main'
if [ "$CURRENT_BRANCH" = "main" ]; then
  echo "🌿 On main branch: Generating component JSON file..."

  # Generate the JSON file (only for main branch)
  pnpm run generate-component-json || exit 1

  # Stage the generated JSON file
  echo "📦 Staging generated JSON file..."
  git add src/app/api/components/components.json || exit 1
fi

# Step 3: Stage all files that have been changed (runs for every branch)
echo "📂 Staging formatted files..."
git add . || exit 1

echo "✅ Pre-commit checks completed successfully!"
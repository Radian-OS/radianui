{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@radianos/typescript-config/nextjs.json",
	"compilerOptions": {
		"allowJs": true,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@public/*": [
				"./public/*"
			],
			"contentlayer/generated": [
				"./.contentlayer/generated"
			]
		}
	},
	"include": [
		"svgr.d.ts",
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"**/*.mdx",
		".contentlayer/generated"
	],
	"exclude": [
		"node_modules"
	]
}
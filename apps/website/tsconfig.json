{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@radianos/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@public/*": [
        "./public/*"
      ],
      "collections/server": [
        "./.source/server.ts"
      ],
      "collections/browser": [
        "./.source/browser.ts"
      ],
      "collections/dynamic": [
        "./.source/dynamic.ts"
      ]
    }
  },
  "include": [
    "svgr.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/**/*.ts",
    "**/*.mdx",
    "next-sitemap.config.cjs",
    "src/app/blocks/verification"
  ],
  "exclude": [
    "node_modules",
    ".source",
    ".next",
    ".turbo"
  ]
}
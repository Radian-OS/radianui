{
  "compilerOptions": {
    "module": "ESNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2019",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
    }
  },
  "lib": [
    "ESNext"
  ],
  "include": [
    "src/**/*",
    "test/**/*",
    "e2e/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
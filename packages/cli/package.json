{
	"name": "radianui",
	"description": "CLI to scaffold React projects and add production-ready UI components with Tailwind CSS",
	"version": "0.3.6",
	"main": "index.js",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": "./dist/index.js",
	"bin": {
		"radianui": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"scripts": {
		"dev": "tsup --watch && tsup",
		"build": "tsup",
		"release": "changeset version",
		"pre:enter": "changeset pre enter alpha",
		"pre:exit": "changeset pre exit",
		"pub:alpha": "pnpm build && pnpm publish --no-git-checks --access public --tag alpha",
		"pub:next": "pnpm build && pnpm publish --no-git-checks --access public --tag next",
		"pub:release": "pnpm build && pnpm publish --no-git-checks --access public",
		"unit": "vitest run --project unit",
		"integration": "vitest run --project integration",
		"e2e": "vitest run --project e2e",
		"test": "vitest run",
		"update-snapshot": "vitest -u",
		"coverage": "vitest run --coverage"
	},
	"keywords": [
		"react",
		"nextjs",
		"vite",
		"cli",
		"component-library",
		"ui-components",
		"tailwindcss",
		"design-system",
		"radianui",
		"radianui-components",
		"radianui-figma",
		"radianui-cli",
		"radianui-resources",
		"radianui-blocks"
	],
	"author": "RadianOS <radianos44@gmail.com> (https://radianui.com)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Radian-os/radianui"
	},
	"homepage": "https://radianui.com",
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"adm-zip": "^0.6.0",
		"chalk": "^5.6.2",
		"commander": "^14.0.2",
		"cosmiconfig": "^10.0.1",
		"dedent": "^1.7.2",
		"deepmerge": "^4.3.1",
		"execa": "^9.6.0",
		"fast-glob": "^3.3.3",
		"fs-extra": "^11.4.0",
		"gradient-string": "^3.0.0",
		"json5": "^2.2.3",
		"kleur": "^4.1.5",
		"node-fetch": "^3.3.2",
		"ora": "^9.4.1",
		"package-manager-detector": "^1.8.0",
		"postcss": "^8.5.26",
		"prompts": "^2.4.2",
		"ts-morph": "^27.0.2",
		"tsconfig-paths": "^4.2.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.8",
		"@types/dedent": "^0.7.2",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.9.2",
		"@types/prompts": "^2.4.9",
		"@vitest/coverage-istanbul": "^4.1.11",
		"cross-env": "^7.0.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"type-fest": "^4.39.1",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.11"
	}
}
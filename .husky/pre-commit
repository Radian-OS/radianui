#!/bin/bash

echo "🚀 Running pre-commit checks..."

# Get the current branch name
CURRENT_BRANCH=$(git branch --show-current)

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Check if any changes are in the website directory
if echo "$STAGED_FILES" | grep -q "^apps/website/"; then
  echo "📦 Changes detected in website directory"
  
  # Run Prettier only on staged website files
  echo "🎨 Formatting code with Prettier for website..."
  pnpm --filter website run format:write || exit 1
  
  # If on main branch, generate component JSON for website
  if [ "$CURRENT_BRANCH" = "dev" ]; then
    echo "🌿 On main branch: Generating component JSON file for website..."
    pnpm --filter website run generate-component-json || exit 1
    
    # Stage the generated JSON file
    if [ -f "apps/website/components.json" ]; then
      echo "📦 Staging generated components.json file..."
      git add apps/website/components.json || exit 1
    fi
  fi
  
  # Re-stage only the website files that were modified by Prettier
  for FILE in $STAGED_FILES; do
    if [[ $FILE == apps/website/* ]]; then
      git add "$FILE" || exit 1
    fi
  done
fi

echo "✅ Pre-commit checks completed successfully!"
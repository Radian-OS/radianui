{
	"name": "radianui-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"website:dev": "turbo run dev --filter=website",
		"website:build": "turbo run build --filter=website",
		"website:start": "turbo run start --filter=website",
		"db:generate": "turbo run db:generate --filter=website",
		"db:migrate": "turbo run db:migrate --filter=website",
		"format:check": "turbo run format:check",
		"format:write": "turbo run format:write",
		"cli:build": "turbo run build --filter=radianui",
		"release": "changeset version",
		"pre:enter": "changeset pre enter alpha",
		"pre:exit": "changeset pre exit",
		"pub:alpha": "cd packages/cli && pnpm pub:alpha",
		"pub:next": "cd packages/cli && pnpm pub:next",
		"pub:release": "cd packages/cli && pnpm pub:release",
		"check-types": "turbo run check-types",
		"generate-component-json": "turbo run generate-component-json",
		"generate-styles": "turbo run generate-styles",
		"generate-css": "turbo run generate-css",
		"generate-styles-json": "turbo run generate-styles-json",
		"update-icon-slot": "turbo run update-icon-slot",
		"generate-icon": "turbo run generate-icon",
		"lint": "turbo run lint",
		"prepare": "husky"
	},
	"pnpm": {
		"overrides": {
			"react": "^19.2.1",
			"react-dom": "^19.2.1",
			"protobufjs": "^7.5.5"
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^22.20.1",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"turbo": "^2.10.12",
		"typescript": "5.8.2"
	},
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@changesets/cli": "^2.31.1",
		"@radix-ui/react-tooltip": "^1.2.16",
		"dotenv-cli": "^8.0.0",
		"zod": "^4.4.3"
	}
}

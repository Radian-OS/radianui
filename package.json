{
  "name": "radian-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node copy-env.js && turbo run dev",
    "website:dev": "node copy-env.js && turbo run dev --filter=website",
    "website:build": "node copy-env.js && turbo run build --filter=website",
    "website:start": "node copy-env.js && turbo run start --filter=website",
    "webapp:dev": "turbo run dev --filter=webapp",
    "webapp:build": "turbo run build --filter=webapp",
    "webapp:start": "turbo run start --filter=webapp",
    "lint": "turbo run lint",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "contentlayer2": "^0.5.5",
    "mdx-bundler": "^10.1.1",
    "next-contentlayer2": "^0.5.5",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0"
  }
}
